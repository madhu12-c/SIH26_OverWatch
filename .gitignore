# Dependencies
node_modules/
__pycache__/
*.pyc

# Secrets - the Gemini key lives in an environment variable, never in a file
.env
.env.*
*.key

# Build output. Regenerate with: cd ui && npm run build
ui/dist/
.vite/

# Regenerable in seconds from specs.json, and 1.2 MB of JSON that rewrites
# itself on every scorer run - noisy diffs for no benefit.
# Everything else in data/output/ IS committed, so a fresh clone can show the
# demo without running the pipeline or spending anything on extraction.
data/output/pair_scores.json

# Real-data source extracts - ~15 MB, re-downloaded by src/mine_real.py.
# data/real/candidates.csv and its labels ARE committed.
data/real/source/

# Team documentation (decisions, risks, judge prep, per-person notes, competitive
# notes) - kept local only, off the repository by team decision (27 Sept 2026).
docs/

# OS
Thumbs.db
.DS_Store

# Bigger runs (15,000 records and up) - regenerated by: python src/run_all.py --run 15k --generate 15000
data/runs/

# Submission material (decks, PDFs, slide graphics, SIH video) - kept local only,
# off the repository by team decision (27 Sept 2026).
deliverables/
brag-output/
